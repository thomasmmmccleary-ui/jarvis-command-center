function CoffeeStation() {
  return (
    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 2 }}>
      <div style={{ fontSize: 16 }}>☕</div>
      <div style={{ width: 36, height: 8, background: 'rgba(120,53,15,0.6)', borderRadius: 2, border: '1px solid rgba(180,83,9,0.4)', display: 'flex', gap: 4, alignItems: 'center', justifyContent: 'center' }}>
        <div style={{ width: 4, height: 4, borderRadius: '50%', background: 'rgba(251,191,36,0.6)' }} />
        <div style={{ width: 4, height: 4, borderRadius: '50%', background: 'rgba(251,191,36,0.4)' }} />
      </div>
      <div style={{ fontSize: 7, color: 'rgba(245,158,11,0.5)', fontFamily: 'JetBrains Mono, monospace' }}>COFFEE</div>
    </div>
  )
}

// ─── The Big Office Floor ─────────────────────────────────────────────────
// 1200 × 700px canvas with zones:
//   - Reception strip (top)
//   - Pod Cluster A–D (4 zones of 6 desks each = 24 desk stations)
//   - Central corridor
//   - Conference room (right)
//   - Lounge / break area (bottom-left)
//   - Water cooler corner
//   - 100+ tiny walking characters

interface OfficeFloorProps {
  agents: LiveAgent[]
  activeAgents: LiveAgent[]
}

function OfficeFloor({ agents, activeAgents }: OfficeFloorProps) {
  // ── desk layout: 4 pods × 6 desks = 24 positions ──
  const PODS = [
    { label: 'POD A — RESEARCH', x: 40,  y: 110, color: '#00f5ff', cols: 3 },
    { label: 'POD B — CREATIVE', x: 260, y: 110, color: '#ec4899', cols: 3 },
    { label: 'POD C — STRATEGY', x: 480, y: 110, color: '#8b5cf6', cols: 3 },
    { label: 'POD D — ENGINEERING', x: 700, y: 110, color: '#3b82f6', cols: 3 },
    { label: 'POD E — ANALYTICS', x: 40,  y: 310, color: '#10b981', cols: 3 },
    { label: 'POD F — CONTENT',   x: 260, y: 310, color: '#f59e0b', cols: 3 },
    { label: 'POD G — MARKETING', x: 480, y: 310, color: '#7c3aed', cols: 3 },
    { label: 'POD H — SOCIAL',    x: 700, y: 310, color: '#f97316', cols: 3 },
  ]

  const DESK_SIZE = { w: 60, h: 50 }

  // Map active agents to desks by category matching
  const deskAssignments: (LiveAgent | null)[] = Array(48).fill(null)
  let deskIdx = 0
  for (const ag of activeAgents) {
    if (deskIdx < 48) {
      deskAssignments[deskIdx++] = ag
    }
  }

  return (
    <div style={{
      position: 'relative',
      width: '100%',
      height: 680,
      overflow: 'hidden',
      background: 'rgba(6,6,20,0.95)',
      backgroundImage: `
        linear-gradient(rgba(0,245,255,0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,245,255,0.018) 1px, transparent 1px)
      `,
      backgroundSize: '40px 40px',
      borderRadius: 10,
      border: '1px solid rgba(0,245,255,0.08)',
    }}>

      {/* ── Reception / Entrance Strip ─────────────────────────── */}
      <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 48, background: 'rgba(0,245,255,0.025)', borderBottom: '1px solid rgba(0,245,255,0.08)', display: 'flex', alignItems: 'center', paddingLeft: 16, gap: 16 }}>
        <div style={{ fontSize: 8, fontFamily: 'JetBrains Mono, monospace', color: 'rgba(0,245,255,0.5)', letterSpacing: 2 }}>↓ ENTRANCE</div>
        <div style={{ flex: 1, height: 1, background: 'linear-gradient(90deg, rgba(0,245,255,0.1), transparent)' }} />
        <div style={{ fontSize: 8, fontFamily: 'JetBrains Mono, monospace', color: 'rgba(0,245,255,0.3)', marginRight: 16 }}>J.A.R.V.I.S. HQ · FLOOR 1</div>
      </div>

      {/* ── Central Corridor ─────────────────────────────────────── */}
      <div style={{ position: 'absolute', top: 48, left: 0, right: 0, height: 56, display: 'flex', alignItems: 'center', borderBottom: '1px solid rgba(255,255,255,0.03)', borderTop: '1px solid rgba(255,255,255,0.03)', background: 'rgba(0,0,0,0.1)' }}>
        {/* corridor dashes */}
        {Array.from({ length: 30 }).map((_, i) => (
          <div key={i} style={{ width: 20, height: 2, background: 'rgba(255,255,255,0.04)', marginRight: 20, borderRadius: 1, flexShrink: 0 }} />
        ))}
      </div>

      {/* ── Desk Pods ────────────────────────────────────────────── */}
      {PODS.map((pod, podI) => {
        const deskStart = podI * 6
        return (
          <div key={pod.label} style={{ position: 'absolute', left: pod.x, top: pod.y }}>
            {/* Pod label */}
            <div style={{ fontSize: 6, fontFamily: 'JetBrains Mono, monospace', color: `rgba(${hexToRgb(pod.color)},0.5)`, letterSpacing: 1.5, marginBottom: 4, whiteSpace: 'nowrap' }}>
              {pod.label}
            </div>
            {/* 6 desks in 2 rows × 3 cols */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '8px 6px', padding: '6px', background: `rgba(${hexToRgb(pod.color)},0.03)`, border: `1px solid rgba(${hexToRgb(pod.color)},0.08)`, borderRadius: 6 }}>
              {Array.from({ length: 6 }).map((_, di) => {
                const globalDeskIdx = deskStart + di
                const occupant = deskAssignments[globalDeskIdx] ?? null
                return (
                  <DeskPod
                    key={di}
                    podIndex={globalDeskIdx}
                    occupant={occupant}
                    occupantIsActive={occupant?.status === 'active'}
                  />
                )
              })}
            </div>
          </div>
        )
      })}

      {/* ── Conference Room (right side) ─────────────────────────── */}
      <div style={{ position: 'absolute', right: 16, top: 110, width: 160, height: 180, background: 'rgba(8,8,30,0.8)', border: '1px solid rgba(0,245,255,0.12)', borderRadius: 8 }}>
        <div style={{ fontSize: 7, fontFamily: 'JetBrains Mono, monospace', color: 'rgba(0,245,255,0.4)', letterSpacing: 1.5, padding: '6px 8px', borderBottom: '1px solid rgba(0,245,255,0.07)' }}>🏢 CONFERENCE</div>
        <div style={{ padding: 12, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8, marginTop: 10 }}>
          <MeetingTable width={130} height={50} />
          <div style={{ display: 'flex', gap: 4 }}>
            {Array.from({ length: 6 }).map((_, i) => (
              <div key={i} style={{ width: 16, height: 10, background: 'rgba(0,245,255,0.06)', border: '1px solid rgba(0,245,255,0.1)', borderRadius: 2 }} />
            ))}
          </div>
          <div style={{ display: 'flex', gap: 4 }}>
            {Array.from({ length: 6 }).map((_, i) => (
              <div key={i} style={{ width: 16, height: 10, background: 'rgba(0,245,255,0.06)', border: '1px solid rgba(0,245,255,0.1)', borderRadius: 2 }} />
            ))}
          </div>
        </div>
      </div>

      {/* ── Lounge / Break Area (bottom-left) ────────────────────── */}
      <div style={{ position: 'absolute', left: 16, bottom: 16, width: 280, height: 160, background: 'rgba(10,5,20,0.85)', border: '1px solid rgba(245,158,11,0.1)', borderRadius: 8 }}>
        <div style={{ fontSize: 7, fontFamily: 'JetBrains Mono, monospace', color: 'rgba(245,158,11,0.5)', letterSpacing: 1.5, padding: '5px 8px', borderBottom: '1px solid rgba(245,158,11,0.07)' }}>☕ BREAK LOUNGE</div>
        <div style={{ display: 'flex', gap: 12, padding: '10px 12px', alignItems: 'flex-end' }}>
          <CoffeeStation />
          <Couch width={80} />
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6, alignItems: 'center' }}>
            <TVSprite size={48} />
            <div style={{ fontSize: 6, color: 'rgba(245,158,11,0.35)', fontFamily: 'JetBrains Mono, monospace' }}>📺 TV</div>
          </div>
          <PlantPot />
        </div>
      </div>

      {/* ── Water Cooler Corner (bottom center) ──────────────────── */}
      <div style={{ position: 'absolute', bottom: 30, left: 320, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4 }}>
        <WaterCooler />
        <div style={{ display: 'flex', gap: 6 }}>
          <PlantPot />
          <PlantPot />
        </div>
      </div>

      {/* ── Window wall (right perimeter) ────────────────────────── */}
      <div style={{ position: 'absolute', right: 0, top: 0, width: 6, height: '100%', background: 'linear-gradient(90deg, transparent, rgba(0,245,255,0.04))', borderRight: '2px solid rgba(0,245,255,0.06)' }} />
      {/* Window panes */}
      {Array.from({ length: 6 }).map((_, i) => (
        <div key={i} style={{ position: 'absolute', right: 8, top: 60 + i * 100, width: 10, height: 60, background: 'rgba(0,245,255,0.03)', border: '1px solid rgba(0,245,255,0.07)', borderRadius: 1 }} />
      ))}

      {/* ── Walking Characters Layer ──────────────────────────────── */}
      <WalkingLayer agents={agents} activeAgents={activeAgents} />
    </div>
  )
}

// ─── Walking Layer — all 100+ agents as tiny moving sprites ───────────────
// Each idle agent is placed at their path origin (deterministic from index)
// and animated via CSS keyframes. Active agents are shown at their desk.

const PATH_ORIGINS: Array<{ x: number; y: number }> = [
  // Path 0: coffee-run — from desk clusters
  { x: 80,  y: 160 }, { x: 110, y: 165 }, { x: 140, y: 160 },
  { x: 300, y: 160 }, { x: 330, y: 165 }, { x: 360, y: 160 },
  { x: 520, y: 160 }, { x: 550, y: 165 }, { x: 580, y: 160 },
  { x: 740, y: 160 }, { x: 770, y: 165 }, { x: 800, y: 160 },

  // Path 1: meeting-walk — from pod E/F area
  { x: 80,  y: 360 }, { x: 110, y: 365 }, { x: 140, y: 360 },
  { x: 300, y: 360 }, { x: 330, y: 365 }, { x: 360, y: 360 },

  // Path 2: stretch-break — open corridor space
  { x: 200, y: 80  }, { x: 400, y: 80  }, { x: 600, y: 80  },
  { x: 800, y: 80  }, { x: 150, y: 80  }, { x: 500, y: 80  },

  // Path 3: lounge-hang — near break area
  { x: 30,  y: 530 }, { x: 60,  y: 545 }, { x: 90,  y: 535 },
  { x: 120, y: 540 }, { x: 150, y: 530 }, { x: 180, y: 545 },

  // Path 4: window-gazer — right perimeter
  { x: 850, y: 120 }, { x: 860, y: 220 }, { x: 855, y: 320 },
  { x: 850, y: 420 }, { x: 860, y: 520 }, { x: 855, y: 620 },

  // Path 5: busy-bee — tight loops near desks
  { x: 75,  y: 140 }, { x: 255, y: 140 }, { x: 475, y: 140 },
  { x: 695, y: 140 }, { x: 75,  y: 340 }, { x: 255, y: 340 },
  { x: 475, y: 340 }, { x: 695, y: 340 },

  // Path 6: social-butterfly — weaves across floor
  { x: 400, y: 200 }, { x: 200, y: 400 }, { x: 600, y: 400 },
  { x: 400, y: 500 }, { x: 100, y: 300 }, { x: 700, y: 300 },

  // Path 7: break-room — near coffee/lounge
  { x: 40,  y: 510 }, { x: 70,  y: 520 }, { x: 100, y: 510 },
  { x: 130, y: 520 }, { x: 160, y: 510 }, { x: 200, y: 520 },
  { x: 230, y: 510 },

  // Path 8: corridor — middle of floor
  { x: 50,  y: 100 }, { x: 200, y: 100 }, { x: 400, y: 100 },
  { x: 600, y: 100 }, { x: 750, y: 100 }, { x: 900, y: 100 },
  { x: 150, y: 100 }, { x: 350, y: 100 }, { x: 550, y: 100 },

  // Path 9: corner-loop — various corner positions
  { x: 40,  y: 200 }, { x: 40,  y: 400 }, { x: 830, y: 200 },
  { x: 830, y: 500 }, { x: 300, y: 560 }, { x: 500, y: 560 },
  { x: 650, y: 560 },
]

function WalkingLayer({ agents, activeAgents }: { agents: LiveAgent[]; activeAgents: LiveAgent[] }) {
  const activeIds = useMemo(() => new Set(activeAgents.map(a => a.id)), [activeAgents])

  // Desk positions for active agents (map to grid positions)
  const DESK_POSITIONS: Array<{ x: number; y: number }> = useMemo(() => {
    const positions: Array<{ x: number; y: number }> = []
    const PODS_POS = [
      { x: 46, y: 130 }, { x: 266, y: 130 }, { x: 486, y: 130 }, { x: 706, y: 130 },
      { x: 46, y: 330 }, { x: 266, y: 330 }, { x: 486, y: 330 }, { x: 706, y: 330 },
    ]
    for (const pod of PODS_POS) {
      for (let row = 0; row < 2; row++) {
        for (let col = 0; col < 3; col++) {
          positions.push({ x: pod.x + col * 60 + 18, y: pod.y + row * 52 + 12 })
        }
      }
    }
    return positions
  }, [])

  return (
    <>
      {agents.map((agent, i) => {
        const isActive = activeIds.has(agent.id)
        const activeIdx = activeAgents.findIndex(a => a.id === agent.id)
        const origin = PATH_ORIGINS[i % PATH_ORIGINS.length]
        const deskPos = isActive && activeIdx >= 0 && activeIdx < DESK_POSITIONS.length
          ? DESK_POSITIONS[activeIdx]
          : undefined

        return (
          <WalkingChar
            key={agent.id}
            agent={agent}
            agentIndex={i}
            isActive={isActive}
            deskX={deskPos?.x}
            deskY={deskPos?.y}
          />
        )
      })}
    </>
  )
}

// ─── Main OfficeScene ──────────────────────────────────────────────────────
export default function OfficeScene() {
  const [agents, setAgents] = useState<LiveAgent[]>([])
  const [activity, setActivity] = useState<ActivitySummary | null>(null)
  const [loading, setLoading] = useState(true)
  const [lastUpdate, setLastUpdate] = useState('')

  const fetchData = useCallback(async () => {
    try {
      const [agRes, actRes] = await Promise.all([
        fetch('/api/agents', { cache: 'no-store' }),
        fetch('/api/activity', { cache: 'no-store' }),
      ])
      const agData = await agRes.json()
      const actData = await actRes.json()
      setAgents(agData.agents ?? [])
      setActivity(actData)
      setLastUpdate(new Date().toLocaleTimeString())
    } catch (e) {
      console.error('Fetch error:', e)
    } finally {
      setLoading(false)
    }
  }, [])

  useEffect(() => {
    fetchData()
    const t = setInterval(fetchData, 5000)
    return () => clearInterval(t)
  }, [fetchData])

  const activeAgents = useMemo(() => agents.filter(a => a.status === 'active'), [agents])
  const idleAgents   = useMemo(() => agents.filter(a => a.status === 'idle'),   [agents])

  return (
    <div
      className="bg-space-grid bg-scanlines"
      style={{ minHeight: '100vh', display: 'flex', flexDirection: 'column', fontFamily: "'Inter', system-ui, sans-serif", background: '#050510', position: 'relative' }}
    >
      {/* ══ HEADER ═══════════════════════════════════════════════════ */}
      <header style={{ padding: '12px 24px', background: 'rgba(5,5,16,0.9)', backdropFilter: 'blur(20px)', borderBottom: '1px solid rgba(0,245,255,0.12)', display: 'flex', alignItems: 'center', justifyContent: 'space-between', position: 'sticky', top: 0, zIndex: 100 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>
          <div style={{ width: 38, height: 38, background: 'linear-gradient(135deg, rgba(0,245,255,0.15), rgba(124,58,237,0.15))', border: '1px solid rgba(0,245,255,0.30)', borderRadius: 10, display: 'flex', alignItems: 'center', justifyContent: 'center', boxShadow: '0 0 20px rgba(0,245,255,0.15)' }}>
            <span style={{ fontSize: 18 }}>🤖</span>
          </div>
          <div>
            <div className="neon-sign" style={{ fontSize: 17, fontWeight: 900, letterSpacing: 3, color: '#00f5ff', textShadow: '0 0 20px rgba(0,245,255,0.8), 0 0 50px rgba(0,245,255,0.3)', fontFamily: 'JetBrains Mono, monospace', lineHeight: 1 }}>J.A.R.V.I.S.</div>
            <div style={{ fontSize: 9, color: 'rgba(148,163,184,0.5)', letterSpacing: 3, fontFamily: 'JetBrains Mono, monospace', marginTop: 2 }}>AI COMMAND CENTER</div>
          </div>
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
            <div style={{ width: 8, height: 8, borderRadius: '50%', background: '#10b981', boxShadow: '0 0 8px #10b981', animation: 'status-pulse 2s ease-in-out infinite' }} />
            <span style={{ fontSize: 9, color: '#10b981', fontFamily: 'JetBrains Mono, monospace', letterSpacing: 1 }}>LIVE</span>
          </div>
          {lastUpdate && <span style={{ fontSize: 8, color: 'rgba(71,85,105,0.7)', fontFamily: 'JetBrains Mono, monospace' }}>↺ {lastUpdate}</span>}
          <a href="/dashboard" style={{ fontSize: 9, color: 'rgba(148,163,184,0.5)', border: '1px solid rgba(255,255,255,0.08)', padding: '5px 12px', borderRadius: 6, textDecoration: 'none', background: 'rgba(255,255,255,0.03)', letterSpacing: 0.5, fontFamily: 'JetBrains Mono, monospace' }}>⊞ DASHBOARD</a>
        </div>
      </header>

      {/* ══ STATS BAR ════════════════════════════════════════════════ */}
      <StatsHeader agents={agents} activity={activity} loading={loading} />

      {/* ══ MAIN CONTENT ═════════════════════════════════════════════ */}
      <div style={{ flex: 1, display: 'flex', overflow: 'hidden' }}>

        {/* ── CENTER: Big Office Floor ──────────────────────────────── */}
        <div style={{ flex: 1, padding: '16px', overflowY: 'auto', minWidth: 0 }}>

          {/* Floor zone header */}
          <div className="hud-corner" style={{ background: 'rgba(8,8,26,0.8)', border: '1px solid rgba(0,245,255,0.10)', borderRadius: 12, marginBottom: 14, overflow: 'hidden', boxShadow: '0 0 30px rgba(0,245,255,0.04)' }}>
            <ZoneHeader
              icon="🏢"
              label="HEADQUARTERS — LIVE OFFICE FLOOR"
              count={`${agents.length} agents · ${activeAgents.length} active`}
              color="#00f5ff"
              badge={activeAgents.length > 0 ? `${activeAgents.length} WORKING` : `${idleAgents.length} STANDBY`}
            />
            <div style={{ padding: '12px 14px' }}>
              <OfficeFloor agents={agents} activeAgents={activeAgents} />
            </div>

            {/* Legend row */}
            <div style={{ padding: '8px 16px', borderTop: '1px solid rgba(0,245,255,0.06)', display: 'flex', gap: 16, flexWrap: 'wrap' }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 6, fontSize: 8, color: 'rgba(148,163,184,0.5)', fontFamily: 'JetBrains Mono, monospace' }}>
                <div style={{ width: 10, height: 10, borderRadius: '50%', background: '#00f5ff', boxShadow: '0 0 6px #00f5ff' }} /> ACTIVE AGENT
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 6, fontSize: 8, color: 'rgba(148,163,184,0.5)', fontFamily: 'JetBrains Mono, monospace' }}>
                <div style={{ width: 10, height: 10, borderRadius: '50%', background: 'rgba(168,85,247,0.6)', border: '1px solid #a855f7' }} /> IDLE — WANDERING
              </div>
              {WALK_PATHS.slice(0, 5).map((p, i) => (
                <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 4, fontSize: 7, color: 'rgba(100,116,139,0.5)', fontFamily: 'JetBrains Mono, monospace' }}>
                  <div style={{ width: 8, height: 8, borderRadius: '50%', background: CHAR_COLORS[i] }} />
                  {p.name.replace('path-', '').replace(/-/g, ' ')}
                </div>
              ))}
            </div>
          </div>

          {/* ── Dept breakdown row ───────────────────────────────── */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(140px, 1fr))', gap: 8, marginBottom: 14 }}>
            {Object.entries(CATEGORY_COLORS).slice(0, 12).map(([cat, color]) => {
              const count = agents.filter(a => a.category === cat).length
              const activeCount = agents.filter(a => a.category === cat && a.status === 'active').length
              if (count === 0) return null
              return (
                <div key={cat} style={{ background: `rgba(${hexToRgb(color)},0.04)`, border: `1px solid rgba(${hexToRgb(color)},0.12)`, borderRadius: 8, padding: '8px 12px' }}>
                  <div style={{ fontSize: 8, fontWeight: 700, color, fontFamily: 'JetBrains Mono, monospace', letterSpacing: 1, marginBottom: 4 }}>{cat.toUpperCase()}</div>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                    <span style={{ fontSize: 16, fontWeight: 800, color }}>{count}</span>
                    {activeCount > 0 && <span style={{ fontSize: 8, color: '#00f5ff', background: 'rgba(0,245,255,0.1)', padding: '1px 5px', borderRadius: 4, fontFamily: 'JetBrains Mono, monospace' }}>{activeCount} active</span>}
                  </div>
                </div>
              )
            })}
          </div>

        </div>

        {/* ── RIGHT SIDEBAR ─────────────────────────────────────────── */}
        <div style={{ width: 290, borderLeft: '1px solid rgba(255,255,255,0.05)', background: 'rgba(5,5,16,0.85)', backdropFilter: 'blur(16px)', display: 'flex', flexDirection: 'column', overflowY: 'auto' }}>
          {/* Active agents panel */}
          <div style={{ padding: '14px 12px 6px' }}>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 10 }}>
              <div style={{ fontSize: 8, color: '#00f5ff', fontFamily: 'JetBrains Mono, monospace', letterSpacing: 2, textShadow: '0 0 8px rgba(0,245,255,0.5)' }}>⚡ ACTIVE AGENTS</div>
              <div style={{ background: activeAgents.length > 0 ? 'rgba(0,245,255,0.15)' : 'rgba(255,255,255,0.05)', color: activeAgents.length > 0 ? '#00f5ff' : 'rgba(100,116,139,0.5)', fontSize: 9, padding: '2px 8px', borderRadius: 12, border: `1px solid ${activeAgents.length > 0 ? 'rgba(0,245,255,0.25)' : 'rgba(255,255,255,0.06)'}`, fontFamily: 'JetBrains Mono, monospace' }}>{activeAgents.length}</div>
            </div>
            {activeAgents.length === 0 ? (
              <div style={{ padding: '28px 16px', textAlign: 'center', background: 'rgba(255,255,255,0.02)', border: '1px solid rgba(255,255,255,0.05)', borderRadius: 10, marginBottom: 8 }}>
                <div style={{ fontSize: 28, marginBottom: 10, opacity: 0.4 }}>😴</div>
                <div style={{ fontSize: 9, color: 'rgba(71,85,105,0.7)', fontFamily: 'JetBrains Mono, monospace' }}>NO ACTIVE AGENTS</div>
                <div style={{ fontSize: 8, color: 'rgba(51,65,85,0.7)', marginTop: 4, lineHeight: 1.5 }}>All {agents.length || 111} specialists wandering</div>
              </div>
            ) : (
              activeAgents.slice(0, 8).map(ag => <ActiveAgentCard key={ag.id} agent={ag} />)
            )}
            {activeAgents.length > 8 && (
              <div style={{ fontSize: 9, color: 'rgba(0,245,255,0.4)', fontFamily: 'JetBrains Mono, monospace', textAlign: 'center', padding: '4px 0' }}>
                +{activeAgents.length - 8} more active…
              </div>
            )}
          </div>

          {/* Divider */}
          <div style={{ height: 1, background: 'rgba(255,255,255,0.04)', margin: '6px 0' }} />

          {/* Activity feed */}
          <div style={{ padding: '10px 12px', flex: 1 }}>
            <div style={{ fontSize: 8, color: '#10b981', fontFamily: 'JetBrains Mono, monospace', letterSpacing: 2, marginBottom: 10, textShadow: '0 0 8px rgba(16,185,129,0.5)' }}>✅ RECENT COMPLETIONS</div>
            {activity?.recentCompleted && activity.recentCompleted.length > 0 ? (
              activity.recentCompleted.slice(0, 6).map((item, i) => <FeedItem key={i} item={item} index={i} />)
            ) : (
              <div style={{ fontSize: 9, color: 'rgba(51,65,85,0.6)', fontFamily: 'JetBrains Mono, monospace', textAlign: 'center', padding: '20px 0' }}>No completions yet today</div>
            )}
          </div>

          {/* Footer */}
          <div style={{ padding: '10px 14px', borderTop: '1px solid rgba(255,255,255,0.04)', background: 'rgba(0,0,0,0.3)' }}>
            <div style={{ fontSize: 7, color: 'rgba(30,41,59,0.8)', fontFamily: 'JetBrains Mono, monospace', lineHeight: 1.7 }}>
              {activity?.dataSource ?? 'Connecting…'}<br />
              Auto-refresh · 5s interval · No simulated data
            </div>
          </div>
        </div>
      </div>

      {/* ══ TICKER BAR ════════════════════════════════════════════════ */}
      <TickerBar />
    </div>
  )
}
