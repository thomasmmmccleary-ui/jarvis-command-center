// ─── Ticker Bar ───────────────────────────────────────────────────────────
function TickerBar() {
  const [idx, setIdx] = useState(0)
  const [fade, setFade] = useState(true)
  useEffect(() => {
    const t = setInterval(() => {
      setFade(false)
      setTimeout(() => { setIdx(i => (i + 1) % TICKER_MSGS.length); setFade(true) }, 300)
    }, 5000)
    return () => clearInterval(t)
  }, [])
  return (
    <div style={{ background: 'rgba(0,0,0,0.6)', backdropFilter: 'blur(8px)', borderTop: '1px solid rgba(0,245,255,0.08)', padding: '7px 20px', display: 'flex', alignItems: 'center', gap: 14 }}>
      <div style={{ background: 'linear-gradient(135deg, #00f5ff, #7c3aed)', color: '#fff', fontSize: 8, padding: '2px 8px', borderRadius: 3, fontWeight: 800, letterSpacing: 1.5, fontFamily: 'JetBrains Mono, monospace', flexShrink: 0, boxShadow: '0 0 10px rgba(0,245,255,0.3)' }}>LIVE</div>
      <div style={{ display: 'flex', gap: 4, flexShrink: 0 }}>
        {TICKER_MSGS.map((_, i) => <div key={i} style={{ width: 5, height: 5, borderRadius: '50%', background: i === idx ? '#00f5ff' : 'rgba(255,255,255,0.1)', boxShadow: i === idx ? '0 0 4px #00f5ff' : 'none', transition: 'all 0.3s' }} />)}
      </div>
      <div style={{ fontSize: 10, color: 'rgba(148,163,184,0.7)', fontFamily: 'JetBrains Mono, monospace', opacity: fade ? 1 : 0, transition: 'opacity 0.3s', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{TICKER_MSGS[idx]}</div>
    </div>
  )
}

// ─── Activity Feed Item ───────────────────────────────────────────────────
function FeedItem({ item, index }: { item: { label: string; goal: string; tokens: number; durationMs?: number; completedAt: string }; index: number }) {
  const elapsed = Math.round((Date.now() - new Date(item.completedAt).getTime()) / 60000)
  const timeLabel = elapsed < 60 ? `${elapsed}m ago` : `${Math.floor(elapsed / 60)}h ago`
  return (
    <div className="feed-item" style={{ padding: '9px 12px', background: 'rgba(255,255,255,0.025)', border: '1px solid rgba(255,255,255,0.06)', borderLeft: '3px solid rgba(16,185,129,0.5)', borderRadius: 7, marginBottom: 6, animationDelay: `${index * 0.05}s` }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: 8 }}>
        <div style={{ fontSize: 10, color: '#10b981', fontWeight: 600, lineHeight: 1.3, flex: 1 }}>✅ {item.label}</div>
        <div style={{ fontSize: 8, color: 'rgba(100,116,139,0.6)', fontFamily: 'JetBrains Mono, monospace', flexShrink: 0 }}>{timeLabel}</div>
      </div>
      <div style={{ fontSize: 9, color: 'rgba(148,163,184,0.6)', lineHeight: 1.4, marginTop: 3 }}>{item.goal.slice(0, 80)}{item.goal.length > 80 ? '…' : ''}</div>
      <div style={{ fontSize: 8, color: 'rgba(100,116,139,0.5)', marginTop: 4, fontFamily: 'JetBrains Mono, monospace' }}>{item.durationMs ? `${Math.round(item.durationMs / 60000)}m` : '—'} · {(item.tokens / 1000).toFixed(1)}k tok</div>
    </div>
  )
}

// ─── Tiny Walking Character ───────────────────────────────────────────────
// Pure CSS animated mini-person. No JS animation loop.
interface WalkingCharProps {
  agent: LiveAgent
  agentIndex: number
  isActive: boolean
  deskX?: number
  deskY?: number
}

function WalkingChar({ agent, agentIndex, isActive, deskX, deskY }: WalkingCharProps) {
  const color = useMemo(() => {
    const idx = CHAR_COLORS.findIndex(c => c === nameToColor(agent.name))
    return idx >= 0 ? CHAR_COLORS[idx] : CHAR_COLORS[agentIndex % CHAR_COLORS.length]
  }, [agent.name, agentIndex])

  const initials = useMemo(() =>
    agent.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()
  , [agent.name])

  const pathIdx = agentIndex % WALK_PATHS.length
  const path = WALK_PATHS[pathIdx]
  const dur = agentDuration(agent.name, path.minDur, path.maxDur).toFixed(1)
  const delay = agentDelay(agent.name).toFixed(1)

  const size = 18

  if (isActive) {
    // Active: fixed at desk position
    return (
      <div
        title={`${agent.name} — ${agent.currentTask ?? 'working'}`}
        style={{
          position: 'absolute',
          left: deskX ?? 0,
          top: deskY ?? 0,
          width: size,
          height: size,
          zIndex: 10,
          cursor: 'default',
        }}
      >
        {/* Active glow ring */}
        <div style={{
          position: 'absolute', inset: -3,
          borderRadius: '50%',
          border: `1px solid ${color}`,
          boxShadow: `0 0 8px ${color}`,
          animation: 'status-pulse 1.5s ease-in-out infinite',
        }} />
        <div style={{
          width: size, height: size, borderRadius: '50%',
          background: color,
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          boxShadow: `0 0 10px ${color}`,
          animation: 'typing-lean 0.4s ease-in-out infinite',
        }}>
          <span style={{ fontSize: 6, fontWeight: 800, color: '#050510', lineHeight: 1, fontFamily: 'JetBrains Mono, monospace' }}>{initials}</span>
        </div>
      </div>
    )
  }

  // Idle: follow pre-programmed walking path
  return (
    <div
      title={agent.name}
      style={{
        position: 'absolute',
        // Base position for the path origin
        left: 0,
        top: 0,
        width: size,
        height: size,
        zIndex: 5,
        willChange: 'transform',
        animation: `${path.name} ${dur}s linear ${delay}s infinite`,
        cursor: 'default',
      }}
    >
      <div style={{
        width: size, height: size, borderRadius: '50%',
        background: `${color}cc`,
        border: `1px solid ${color}`,
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        boxShadow: `0 0 4px ${color}60`,
        animation: 'idle-bob 2s ease-in-out infinite',
        animationDelay: `${delay}s`,
      }}>
        <span style={{ fontSize: 5, fontWeight: 700, color: '#050510', lineHeight: 1, fontFamily: 'JetBrains Mono, monospace' }}>{initials}</span>
      </div>
    </div>
  )
}

// ─── Office Furniture: Desk Pod ───────────────────────────────────────────
function DeskPod({ podIndex, occupant, occupantIsActive }: {
  podIndex: number
  occupant: LiveAgent | null
  occupantIsActive: boolean
}) {
  const color = occupant ? nameToColor(occupant.name) : 'rgba(255,255,255,0.06)'
  const elapsed = useElapsed(occupant?.startedAt)
  return (
    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 2, position: 'relative' }}>
      {/* Laptop on desk */}
      <div style={{ position: 'relative' }}>
        <LaptopSprite glowing={occupantIsActive} size={16} />
      </div>
      {/* Desk surface */}
      <div style={{
        width: 52, height: 7,
        background: occupantIsActive
          ? `linear-gradient(90deg, rgba(${hexToRgb(color)},0.1), rgba(${hexToRgb(color)},0.25), rgba(${hexToRgb(color)},0.1))`
          : 'rgba(30,41,59,0.7)',
        border: `1px solid ${occupantIsActive ? `rgba(${hexToRgb(color)},0.4)` : 'rgba(255,255,255,0.06)'}`,
        borderRadius: 2,
        boxShadow: occupantIsActive ? `0 0 10px rgba(${hexToRgb(color)},0.3)` : 'none',
      }} />
      {/* Legs */}
      <div style={{ display: 'flex', gap: 36 }}>
        <div style={{ width: 2, height: 6, background: 'rgba(30,41,59,0.8)' }} />
        <div style={{ width: 2, height: 6, background: 'rgba(30,41,59,0.8)' }} />
      </div>
      {/* Status + label */}
      <div style={{ fontSize: 6, color: occupantIsActive ? `rgba(${hexToRgb(color)},0.8)` : 'rgba(71,85,105,0.5)', fontFamily: 'JetBrains Mono, monospace', letterSpacing: 0.5 }}>
        {occupantIsActive ? `● D${(podIndex + 1).toString().padStart(2, '0')}` : `D${(podIndex + 1).toString().padStart(2, '0')}`}
      </div>
    </div>
  )
}

